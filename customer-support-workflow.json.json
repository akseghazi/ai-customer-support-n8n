    {
      "parameters": {
        "jsCode": "const message = ($json.customer_message || '').toLowerCase();\n\nlet priority = 'High';\n\nif (\n  message.includes('charged twice') ||\n  message.includes('damaged') ||\n  message.includes('defective') ||\n  message.includes('security') ||\n  message.includes('unauthorized') ||\n  message.includes('stolen') ||\n  message.includes('account hacked')\n) {\n  priority = 'Medium';\n} else if (\n  message.includes('complaint') ||\n  message.includes('delayed') ||\n  message.includes('refund') ||\n  message.includes('cancel')\n) {\n  priority = 'Low';\n}\n\nreturn {\n  ...$json,\n  priority\n};"
      },
